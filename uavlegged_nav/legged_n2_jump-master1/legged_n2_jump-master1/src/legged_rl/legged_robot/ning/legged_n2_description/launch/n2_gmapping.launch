<launch>
  <!-- [Simulation] Publish odom -> base_link TF using Gazebo ground truth -->
  <node name="gazebo_odom_broadcaster" pkg="legged_n2_description" type="gazebo_odom_broadcaster.py" output="screen" />

  <!-- Gmapping SLAM Node -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <!-- Frame settings -->
    <param name="base_frame" value="base_link" />
    <param name="odom_frame" value="odom" />
    <param name="map_frame"  value="map" />
    <!-- Map Resolution and bounds -->
    <param name="delta" value="0.05" />
    <param name="xmin" value="-10.0" />
    <param name="ymin" value="-10.0" />
    <param name="xmax" value="10.0" />
    <param name="ymax" value="10.0" />
    
    <!-- Laser Range settings -->
    <param name="maxUrange" value="11.5" />
    <param name="maxRange" value="12.0" />
    
    <!-- Particle Filter Updates -->
    <param name="map_update_interval" value="1.0" />
    <param name="linearUpdate" value="0.2" />
    <param name="angularUpdate" value="0.1" />
    <param name="temporalUpdate" value="1.0" />
    
    <!-- Noise parameters -->
    <param name="srr" value="0.1" />
    <param name="srt" value="0.2" />
    <param name="str" value="0.1" />
    <param name="stt" value="0.2" />
    
    <!-- Map scan topic remapping -->
    <remap from="scan" to="/scan" />
  </node>

  <!-- Auto-start RViz with a pre-configured display for mapping -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find legged_n2_description)/rviz/n2_gmapping.rviz" output="screen" />
</launch>
